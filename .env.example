# Copy to .env.  Only the key for the model you use is needed (LiteLLM naming).
DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# Where traces / artifacts go (default: ./runs)
# REPROAGENT_DATA_DIR=runs
# Record full prompts in the trace DB (default true; set false to keep the DB small)
# REPROAGENT_RECORD_LLM=true
